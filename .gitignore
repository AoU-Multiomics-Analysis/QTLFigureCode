# macOS
.DS_Store

# Controlled-access QTL inputs staged into the working dir (never commit).
# Figure scripts gsutil-cache inputs under the cwd in these subdirs, or set
# FIG*_INPUT to relocate them.
#
# Current per-figure staging roots, as declared in each Fig<N>/inputs.tsv.
/Fig1Data/
/Fig2Data/
/Fig3Data/
/Fig4Data/
/Fig5Data/
# Legacy staging roots kept so older working copies stay covered.
/permutations/
/finemapping/
/annotated/
/enloc/
/external/
/expression/
/reference/
/input_data/
/high_level_coloc_outputs/
/R2_TWAS_combined.tsv
/ConditionalTWAS.cleaned.tsv.gz
/data/
/susie_local/

# Figure outputs. Each figure's assemble.R writes into its OWN directory
# (FIG<N>_OUTDIR, default fig<n>/), so the outputs are ignored there. The
# bare-root entries are kept as well: FIG<N>_OUTDIR can still be pointed at the
# repo root, and older runs left files there.
/Fig?/*.pdf
/Fig?/*.png
/SuppFig?/*.pdf
/SuppFig?/*.png

# Same outputs when OUTDIR is pointed at the repo root instead.
/Figure1.pdf
/Figure1.png
/xGeneMetasoftSummary.pdf
/Fig2.pdf
/Fig2.png
/FigS_*.pdf
/FigS_*.png
/Figure3.pdf
/Figure3.png
/Figure4.pdf
/Figure4.png
/Figure5.pdf
/Figure5.png
/SupplementalFig1.pdf
/SupplementalFig1.png

# MetaSoft intermediates
/*_wide_metasoft_input.tsv
/*.metasoft.tsv
